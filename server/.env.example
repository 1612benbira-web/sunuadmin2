PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sunuadmin
# Base de test : le nom DOIT finir par _test (elle est vidée à chaque lancement des tests)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/sunuadmin_test
JWT_SECRET=changez-moi-longue-chaine-aleatoire-32-caracteres-minimum
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Proxys devant l'API : 0 en local ; 1 si Render seul ; 2 si Vercel relaie vers Render
TRUST_PROXY=0
# Fichiers : disque local par défaut (UPLOAD_DIR) ; stockage objet privé S3 si S3_BUCKET est défini
UPLOAD_DIR=uploads
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Uniquement pour create-admin (à supprimer ensuite) et seed (développement)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# DEMO_PASSWORD=
